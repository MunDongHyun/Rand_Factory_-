# OpenAI
OPENAI_API_KEY=sk-...

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=landfactory

# App
APP_ENV=development
SECRET_KEY=your_secret_key_here

# RAG
CHROMA_PERSIST_DIR=./chroma_db

# AI scripts
AI_MODEL=gpt-5.4-mini

# SMTP (Gmail 앱 비밀번호 사용 권장)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_NAME=LandFactory

# Cloudflare R2 첨부파일 저장소 (모두 비워두면 server/uploads 로컬 저장 fallback)
# R2_ENDPOINT_URL 은 반드시 https://<ACCOUNT_ID>.r2.cloudflarestorage.com 형태여야 함
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_REGION=auto

# CORS (쉼표 구분, 공백 무시). 비워두면 dev 기본값 사용
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
