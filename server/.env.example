# OpenAI
OPENAI_API_KEY = your_openai_api_key_here


# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=landfactory

# App
APP_ENV=development
SECRET_KEY=your_secret_key_here

# RAG
CHROMA_PERSIST_DIR=./chroma_db

# AI scripts
AI_MODEL=gpt-5.4-mini

# SMTP (Gmail 앱 비밀번호 사용 권장)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_NAME=LandFactory

# Cloudflare R2 첨부파일 저장소 (모두 비워두면 server/uploads 로컬 저장 fallback)
# R2_ENDPOINT_URL 은 반드시 https://<ACCOUNT_ID>.r2.cloudflarestorage.com 형태여야 함
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_REGION=auto

# CORS (쉼표 구분, 공백 무시). 비워두면 dev 기본값 사용
# 배포 시 배포된 프론트 도메인을 반드시 추가. 예: https://articulum.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------------------
# Render 배포용 추가 환경변수 가이드
# ---------------------------------------------------------------------------
# - PORT — Render가 자동 주입. 별도 설정 불필요
# - 로컬 .env 그대로 복사 + CORS_ORIGINS 만 배포 프론트 도메인으로 변경
# - SECRET_KEY는 배포 환경에서 새로 생성 권장 (`python -c "import secrets; print(secrets.token_hex(32))"`)
# - R2/SMTP/OPENAI/DB 자격증명은 로컬과 동일하게 사용 가능 (학원 DB는 외부 접속 가능 확인됨)
# - CHROMA_PERSIST_DIR 은 도커 이미지에 chroma_db 가 포함되어 있다는 가정 하에 기본값 유지
