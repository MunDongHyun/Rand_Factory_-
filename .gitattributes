# git이 텍스트 파일 줄바꿈을 자동으로 normalize
# (커밋 시 LF, 체크아웃 시 OS 기본)
* text=auto

# Windows 전용 스크립트는 CRLF 강제
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 셸 스크립트는 LF 강제 (실행 호환성)
*.sh text eol=lf

# 바이너리 파일은 손대지 않음
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
